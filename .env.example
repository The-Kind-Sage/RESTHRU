# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (pooler for runtime)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Database (direct for migrations, set on Vercel as DIRECT_URL)
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require

# JWT
JWT_SECRET=your-secret-key

# Payment webhook — shared secret used to verify the HMAC-SHA256 signature
# (x-webhook-signature header) on POST /api/webhooks/payment. Required; the
# endpoint rejects all calls when unset.
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Public origin used when generating table QR codes (no trailing slash).
# Without this, a QR generated while browsing the admin on localhost encodes
# "http://localhost:3000", which a guest's phone cannot reach.
NEXT_PUBLIC_APP_URL=https://your-domain.com
