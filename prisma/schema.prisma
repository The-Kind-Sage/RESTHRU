generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String?
  firstName     String   @default("")
  lastName      String   @default("")
  phoneNumber   String   @default("")
  profileImage  String?
  role          String   @default("STAFF")
  restaurantId  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  restaurant    Restaurant?     @relation(fields: [restaurantId], references: [id])
  notifications Notification[]
}

model Restaurant {
  id              String   @id @default(cuid())
  ownerId         String?
  name            String
  description     String?
  type            String   @default("CASUAL_DINING")
  email           String   @default("")
  phoneNumber     String   @default("")
  websiteUrl      String?
  logoUrl         String?
  bannerImageUrl  String?
  street          String   @default("")
  city            String   @default("")
  state           String   @default("")
  postalCode      String   @default("")
  country         String   @default("Nepal")
  latitude        Float?
  longitude       Float?
  timezone        String   @default("Asia/Kathmandu")
  currency        String   @default("NPR")
  language        String   @default("en")
  taxPercentage   Float    @default(13)
  serviceCharge   Float    @default(10)
  enableGST       Boolean  @default(false)
  gstNumber       String?
  enableQRMenu    Boolean  @default(true)
  totalTables     Int      @default(0)
  totalStaff      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users         User[]
  staff         Staff[]
  tables        RestaurantTable[]
  categories    Category[]
  menuItems     MenuItem[]
  orders        Order[]
  inventory     InventoryItem[]
  bills         Bill[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  subscriptions Subscription[]
  operatingHours OperatingHours[]
  kpiCards      KpiCard[]
}

model OperatingHours {
  id        String  @id @default(cuid())
  restaurantId String
  dayOfWeek Int
  isOpen    Boolean @default(true)
  openTime  String  @default("09:00")
  closeTime String  @default("22:00")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, dayOfWeek])
}

model Plan {
  id            String   @id @default(cuid())
  type          String   @unique
  name          String
  description   String   @default("")
  monthlyPrice  Float    @default(0)
  annualPrice   Float    @default(0)
  maxRestaurants Int     @default(1)
  maxTables     Int      @default(10)
  maxStaff      Int      @default(5)
  maxMenuItems  Int      @default(50)
  features      String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id            String   @id @default(cuid())
  restaurantId  String
  planId        String
  status        String   @default("ACTIVE")
  startDate     DateTime
  endDate       DateTime
  autoRenew     Boolean  @default(true)
  billingCycle  String   @default("MONTHLY")
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  plan       Plan       @relation(fields: [planId], references: [id])
}

model Staff {
  id            String   @id @default(cuid())
  restaurantId  String
  firstName     String
  lastName      String   @default("")
  email         String   @default("")
  phoneNumber   String   @default("")
  profileImage  String?
  role          String
  status        String   @default("ACTIVE")
  salary        Float    @default(0)
  joinDate      DateTime @default(now())
  dateOfBirth   DateTime?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}

model RestaurantTable {
  id              String   @id @default(cuid())
  restaurantId    String
  tableNumber     Int
  qrCode          String   @default("")
  capacity        Int      @default(4)
  shape           String   @default("SQUARE")
  location        String?
  status          String   @default("AVAILABLE")
  currentOrderId  String?
  occupiedSince   DateTime?
  assignedWaiterId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, tableNumber])
}

model Category {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  description   String?
  imageUrl      String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems MenuItem[]
}

model MenuItem {
  id            String   @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  imageUrl      String?
  price         Float
  discountPrice Float?
  foodType      String   @default("VEG")
  spiceLevel    String   @default("NONE")
  allergens     String[] @default([])
  prepTime      Int      @default(15)
  calories      Int?
  ingredients   String[] @default([])
  isAvailable   Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant  Restaurant @relation(fields: [restaurantId], references: [id])
  category    Category   @relation(fields: [categoryId], references: [id])
  addOns      AddOn[]
  orderItems  OrderItem[]
}

model AddOn {
  id          String  @id @default(cuid())
  menuItemId  String
  name        String
  description String?
  price       Float   @default(0)
  isAvailable Boolean @default(true)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model Order {
  id              String   @id @default(cuid())
  restaurantId    String
  tableId         String?
  orderId         String   @unique
  orderType       String   @default("DINE_IN")
  status          String   @default("PENDING")
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  serviceCharge   Float    @default(0)
  discountAmount  Float    @default(0)
  discountReason  String?
  totalAmount     Float    @default(0)
  assignedWaiterId String?
  customerName    String?
  customerPhone   String?
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id])
  table       RestaurantTable? @relation(fields: [tableId], references: [id])
  items       OrderItem[]
  bills       Bill[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  menuItemId          String
  menuItemName        String
  quantity            Int      @default(1)
  pricePerUnit        Float    @default(0)
  specialInstructions String?
  addOnData           Json     @default("[]")
  status              String   @default("PENDING")
  preparedAt          DateTime?
  servedAt            DateTime?

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model InventoryItem {
  id              String   @id @default(cuid())
  restaurantId    String
  name            String
  description     String?
  unit            String   @default("pieces")
  currentQuantity Float    @default(0)
  reorderLevel    Float    @default(10)
  reorderQuantity Float    @default(20)
  unitCost        Float    @default(0)
  supplier        String?
  status          String   @default("HEALTHY")
  lastRestockDate DateTime?
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id])
  historyEntries InventoryHistory[]
}

model InventoryHistory {
  id              String   @id @default(cuid())
  inventoryItemId String
  movementType    String
  quantity        Float
  reason          String?
  recordedBy      String
  createdAt       DateTime @default(now())

  item InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model Bill {
  id              String   @id @default(cuid())
  restaurantId    String
  orderId         String
  billNumber      String   @unique
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  serviceCharge   Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float    @default(0)
  amountPaid      Float    @default(0)
  change          Float    @default(0)
  paymentMethod   String   @default("CASH")
  paymentRef      String?
  billDate        DateTime @default(now())
  settledAt       DateTime?
  createdBy       String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
}

model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  restaurantId    String
  type            String
  title           String
  message         String
  relatedEntityId String?
  relatedEntityType String?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  actionUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User       @relation(fields: [recipientUserId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}

model ActivityLog {
  id            String   @id @default(cuid())
  restaurantId  String
  userId        String
  actionType    String
  entityType    String
  entityId      String
  changesBefore Json?
  changesAfter  Json?
  description   String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}

model KpiCard {
  id          String   @id @default(cuid())
  restaurantId String
  title       String
  value       String
  unit        String?
  trend       String   @default("STABLE")
  changePct   Float?
  icon        String?
  color       String?
  lastUpdated DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}
